DATASOURCE_URL=jdbc:h2:mem:urlshortener
H2_CONSOLE_ENABLED=true

# Required when running with -Dspring-boot.run.profiles=test or =prod
# (overrides DATASOURCE_URL above with a real Postgres connection)
# DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
# DATASOURCE_USERNAME=<username>
# DATASOURCE_PASSWORD=<password>

