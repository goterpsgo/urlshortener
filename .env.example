DATASOURCE_URL=jdbc:h2:mem:urlshortener
H2_CONSOLE_ENABLED=true
# Generate your own with: openssl rand -base64 48
JWT_SECRET=<generate-a-unique-secret-per-environment>

# Feature flags — per-environment default, overridable per user via the
# users.h1_green_enabled column (NULL = use this default).
# FEATURE_H1_GREEN=false

# Admin account bootstrap — seeded once by V5__seed_admin_user.sql on first
# migration run (Flyway only ever runs a given migration once, so this
# doesn't re-insert on every restart). Required — the app won't start without
# both set. Generate the hash with the app's own BCryptPasswordEncoder, e.g.:
#   jshell --class-path "$(find ~/.m2 -name 'spring-security-crypto-*.jar' | head -1):$(find ~/.m2 -name 'commons-logging-*.jar' | head -1)"
#   jshell> new org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder().encode("your-chosen-password")
# See docs/SECURITY.md's "Admin bootstrap" section.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-chosen-admin-password>

# Required when running with -Dspring-boot.run.profiles=test or =prod
# (overrides DATASOURCE_URL above with a real Postgres connection)
# DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
# DATASOURCE_USERNAME=<username>
# DATASOURCE_PASSWORD=<password>

